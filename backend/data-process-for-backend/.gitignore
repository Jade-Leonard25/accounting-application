# ==========================================
# Node.js / Bun / Hono Backend & Frontend
# ==========================================
node_modules/
dist/
build/
.env
.env.local
.env.*.local

# Package managers & lock files (if you prefer not to commit them, though bun.lock is usually kept)
# .bun
# bun.lockb

# Vite / Electron / Build artifacts
.vite/
out/
release/

# ==========================================
# Go Backend
# ==========================================
# Binaries for Go programs
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with 'go test -c'
*.test

# Output of the go coverage tool, specifically when created with individual packages
*.out

# Dependency directories (only if vendor directory is used, usually Go modules handle this)
# vendor/

# Air (Live reload tool for Go) temporary files / build directories
tmp/
.air/

# ==========================================
# Operating System & IDE Files
# ==========================================
# macOS
.DS_Store

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Vim / JetBrains
*.swp
*.swo
.idea/